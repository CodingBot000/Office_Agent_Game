# Copy this file to .env before running the backend.
# Replace local values as needed; never commit backend/.env.

APP_NAME=AI Office Agent API
API_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local: use the existing CLI authentication/session.
# Remote: change this to openai and provide OPENAI_API_KEY below.
# Tests: use deterministic-mock to run without any provider credentials.
AI_PROVIDER=cli

# OpenAI connection settings for local development.
# This is an example placeholder, not a real credential.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30

# CLI adapter settings (local only).
AI_CLI_COMMAND=codex
AI_CLI_MODEL=gpt-5.6-luna
AI_CLI_TIMEOUT_SECONDS=120
