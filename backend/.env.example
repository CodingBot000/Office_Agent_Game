# Copy this file to .env before running the backend.
# Replace the OpenAI placeholder values locally; never commit backend/.env.

APP_NAME=AI Office Agent API
API_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Phase 1 defaults to the deterministic provider so the game runs without a key.
# Change to openai after the OpenAI provider is enabled in the backend.
AI_PROVIDER=deterministic-mock

# OpenAI connection settings for local development.
# This is an example placeholder, not a real credential.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=replace-with-a-supported-openai-model
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
